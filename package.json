{
  "name": "nofy-helper",
  "version": "0.1.0",
  "private": true,
  "description": "nofy-api 桌面辅助工具，内置 Codex 中文修复",
  "author": "Nofy",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "npm run build && node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:win": "npm run check && electron-builder --win --x64 --dir",
    "dist:win": "npm run check && electron-builder --win nsis --x64 --publish never",
    "ui:prepare": "node scripts/build.mjs --ui",
    "ui:preview": "npm run ui:prepare && node scripts/preview-ui.mjs",
    "test:ui": "node tests/ui.spec.mjs",
    "dist:mac": "npm run check && electron-builder --mac --publish never",
    "dist:linux": "npm run check && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "com.nofy.helper",
    "productName": "nofy-helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "nofy-helper-${version}-${arch}-setup.${ext}",
      "icon": "assets/branding/nofy-helper-app.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "assets/branding/nofy-helper-app.png",
    "mac": {
      "icon": "assets/branding/nofy-helper-app.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "nofy-helper-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/branding/nofy-helper-app.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "nofy-helper-${version}-linux-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/wells974/nofy-helper",
  "repository": {
    "type": "git",
    "url": "https://github.com/wells974/nofy-helper.git"
  }
}
